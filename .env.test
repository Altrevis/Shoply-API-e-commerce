# Test Environment Variables
NODE_ENV=test

# Database (Use test database)
DB_HOST=localhost
DB_USER=test_user
DB_PASSWORD=test_password
DB_NAME=shoply_test

# Mailtrap (Mock values for testing)
MAILTRAP_SMTP_USER=test-user
MAILTRAP_SMTP_PASS=test-password
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAIL_FROM=test@example.com
MAIL_FROM_NAME=Shoply Test

# OneSignal (Mock values for testing)
ONESIGNAL_APP_ID=test-app-id
ONESIGNAL_REST_KEY=test-rest-key

# OAuth
OAUTH_CLIENT_ID=test-client-id
OAUTH_CLIENT_SECRET=test-client-secret

# Server
PORT=3001
